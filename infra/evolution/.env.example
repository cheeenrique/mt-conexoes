# infra/evolution/.env.example
#
# Copie para `.env` na mesma pasta e preencha os valores reais.
# ⚠️ `.env` NUNCA é commitado (já está no .gitignore da raiz do projeto —
# confira antes do primeiro `git add`). Nenhum segredo real fica neste arquivo.
#
# Variáveis aqui alimentam dois consumidores:
#   1. O próprio `docker compose` (interpolação em docker-compose.yml e Caddyfile).
#   2. O processo da Evolution API dentro do container (via `env_file: .env`
#      no serviço `evolution-api`).
# `DATABASE_CONNECTION_URI` e `CACHE_REDIS_URI` NÃO ficam aqui — são montadas
# no próprio docker-compose.yml a partir de POSTGRES_* e REDIS_PASSWORD, pra
# senha não existir duplicada em dois lugares que podem divergir.

# ─────────────────────────────────────────────────────────────────────────
# Domínio e TLS (Caddy)
# ─────────────────────────────────────────────────────────────────────────

# Domínio próprio da Evolution, DNS já apontando para o IP desta VPS antes de
# subir — Caddy pede o certificado Let's Encrypt na primeira request e falha
# silenciosamente (fica tentando) se a porta 80/443 não bater no domínio certo.
# Nunca reusar domínio do painel ou do site: ver CLAUDE.md "Duas aplicações".
EVOLUTION_DOMAIN=evolution.seudominio.com.br

# E-mail que a Let's Encrypt usa pra avisar de expiração/problema de certificado.
CADDY_EMAIL=ops@seudominio.com.br

# ─────────────────────────────────────────────────────────────────────────
# Postgres da Evolution — banco PRÓPRIO, separado do Postgres do painel (Neon).
# Ver README.md "Divergência encontrada": neste banco fica a credencial de
# sessão do WhatsApp, não só metadado. É o dado mais crítico desta VPS.
# ─────────────────────────────────────────────────────────────────────────

POSTGRES_USER=evolution
# Gerar com: openssl rand -base64 32
POSTGRES_PASSWORD=troque-antes-de-subir
POSTGRES_DB=evolution

# ─────────────────────────────────────────────────────────────────────────
# Redis — cache da Evolution (grupos, contatos, dedupe). NÃO guarda a
# credencial de sessão do WhatsApp nesta configuração (CACHE_REDIS_SAVE_INSTANCES
# abaixo fica false de propósito). Ainda assim leva senha: fica só na rede
# interna do compose, mas defesa em profundidade é barata.
# ─────────────────────────────────────────────────────────────────────────

# Gerar com: openssl rand -base64 32
REDIS_PASSWORD=troque-antes-de-subir

# ─────────────────────────────────────────────────────────────────────────
# Evolution API — servidor e autenticação
# ─────────────────────────────────────────────────────────────────────────

# URL pública completa (com https e domínio), usada pela própria Evolution
# para montar links e pro Manager (desativado abaixo, mas o valor é lido de
# qualquer forma). Precisa bater com EVOLUTION_DOMAIN acima.
SERVER_URL=https://evolution.seudominio.com.br

# ⚠️ A CHAVE MAIS IMPORTANTE DESTE ARQUIVO. Quem tiver ela + a URL manda
# mensagem pelo WhatsApp do cliente (ver README.md "Segurança"). Gerar com:
#   openssl rand -hex 32
# NUNCA usar o valor de exemplo do .env.example oficial da Evolution
# (429683C4C977415CAAFCCE10F7D57E11) — é público, está no GitHub deles.
AUTHENTICATION_API_KEY=troque-antes-de-subir

# Se as instâncias devem aparecer no endpoint GET /instance/fetchInstances
# sem instanceName (lista tudo). Com uma instância só, não faz diferença —
# mantém o default.
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# ⚠️ Evolution Manager (UI web em /manager) FICA DESLIGADA. Ver README.md
# "Evolution Manager" para o passo a passo de ligar temporariamente e
# protegida, se precisar dela pra depurar pareamento na mão.
SERVER_DISABLE_MANAGER=true

TZ=America/Sao_Paulo

# CORS: a Evolution só é chamada servidor-a-servidor pelo painel (Server
# Action / adapter), nunca por fetch() do navegador — não há origem de
# browser que precise passar. Deixado amplo (*) só porque não há risco real
# nesse fluxo; se um dia expuser o Manager, aperte isto primeiro.
CORS_ORIGIN=*

# ─────────────────────────────────────────────────────────────────────────
# Banco de dados — onde a Evolution guarda instância, sessão e mensagens
# ─────────────────────────────────────────────────────────────────────────

DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_CLIENT_NAME=mt_conexoes_evolution

# true é o que faz a credencial de sessão (auth state do Baileys) ser
# salva no Postgres acima em vez de arquivo local — ver README.md
# "Divergência encontrada". Não desligar sem entender a consequência.
DATABASE_SAVE_DATA_INSTANCE=true

# ─────────────────────────────────────────────────────────────────────────
# Cache (Redis) — confirmado contra o código da 2.3.7: usado por padrão
# ─────────────────────────────────────────────────────────────────────────

CACHE_REDIS_ENABLED=true

# false de propósito: mantém a credencial de sessão no Postgres (fonte única,
# já coberta por backup de banco), em vez de espalhar em dois lugares.
CACHE_REDIS_SAVE_INSTANCES=false

CACHE_LOCAL_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────
# Telemetria e logs
# ─────────────────────────────────────────────────────────────────────────

# Desligado: minimiza o que sai desta VPS para servidor de terceiro. Não é
# dado sensível (não inclui conteúdo de mensagem), mas sem necessidade de
# negócio pra mandar.
TELEMETRY_ENABLED=false

# ⚠️ Sem WEBHOOKS nem VERBOSE/DEBUG na lista: LOG_LEVEL com "WEBHOOKS" faz a
# Evolution logar o corpo de cada webhook recebido/emitido — e o webhook de
# inbound carrega o texto que o assinante escreveu (ex.: "PARE"). CLAUDE.md
# "Segurança" proíbe conteúdo de mensagem em log.
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error

# ─────────────────────────────────────────────────────────────────────────
# Cosmético — aparece na tela de pareamento do celular
# ─────────────────────────────────────────────────────────────────────────

CONFIG_SESSION_PHONE_CLIENT=MT Conexoes
CONFIG_SESSION_PHONE_NAME=Chrome
