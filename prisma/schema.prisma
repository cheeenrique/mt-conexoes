generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid(7))
  email          String   @unique
  name           String
  passwordHash   String // argon2id
  sessionVersion Int      @default(0) // bump invalida sessões existentes (troca de senha)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  anonymizedCustomers Customer[] @relation("CustomerAnonymizedBy")

  @@map("users")
}

enum LoginAttemptOutcome {
  SUCCESS
  INVALID_CREDENTIALS
  RATE_LIMITED
}

/// Auditoria + rate limit de login por IP e por e-mail — sem Redis. Toda
/// tentativa (sucesso, credencial inválida ou bloqueio) grava uma linha.
model LoginAttempt {
  id        String   @id @default(uuid(7))
  ip        String
  email     String?
  outcome   LoginAttemptOutcome
  userAgent String?
  createdAt DateTime            @default(now())

  @@index([ip, createdAt])
  @@index([email, createdAt])
  @@map("login_attempts")
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

model Settings {
  id                 String   @id @default("singleton")
  businessName       String
  timezone           String   @default("America/Sao_Paulo")
  quietHourStart     Int      @default(8)
  quietHourEnd       Int      @default(20)
  sendingPaused      Boolean  @default(false)
  pixKey             String?
  pixHolderName      String?
  marginAlertPercent Decimal  @default(30) @db.Decimal(5, 2)
  updatedAt          DateTime @updatedAt

  @@map("settings")
}

model Supplier {
  id            String   @id @default(uuid(7))
  name          String   @unique
  unitCostCents BigInt   @default(0)
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  plans         Plan[]
  subscriptions Subscription[]
  charges       Charge[]

  @@map("suppliers")
}

model Plan {
  id         String       @id @default(uuid(7))
  name       String       @unique
  priceCents BigInt       @default(0)
  costCents  BigInt       @default(0)
  cycle      BillingCycle @default(MONTHLY)
  supplierId String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())

  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ChargeStatus {
  OPEN
  OVERDUE
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  PIX
  CASH
  TRANSFER
  CARD
  OTHER
}

enum PaymentSource {
  MANUAL
  WEBHOOK
}

model Customer {
  id             String    @id @default(uuid(7))
  name           String
  phone          String?
  email          String?
  document       String?
  notes          String?
  optedOut       Boolean   @default(false)
  optedOutAt     DateTime?
  optedOutReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /// Direito de eliminação (LGPD). `null` enquanto o cliente não foi anonimizado —
  /// é o que a tela usa pra decidir entre ficha normal e ficha "Anonimizado", e o
  /// que os guards de despacho/avaliação da régua usam pra nunca mandar mensagem
  /// pra quem pediu eliminação. Ver `core/anonymization.ts`.
  anonymizedAt       DateTime?
  anonymizedByUserId String?
  anonymizedByUser   User?     @relation("CustomerAnonymizedBy", fields: [anonymizedByUserId], references: [id])

  subscriptions Subscription[]
  charges       Charge[]
  messages      Message[]
  leads         Lead[]

  @@unique([phone])
  @@index([name])
  @@index([anonymizedAt])
  @@map("customers")
}

model Subscription {
  id         String  @id @default(uuid(7))
  customerId String
  planId     String?
  supplierId String?

  priceCents BigInt
  costCents  BigInt       @default(0)
  cycle      BillingCycle @default(MONTHLY)

  nextDueAt DateTime
  startedAt DateTime @default(now())

  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(10, 2)
  discountUntil DateTime?

  status       SubscriptionStatus @default(ACTIVE)
  suspendedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  accessUsername    String?
  accessPasswordEnc String?
  accessServer      String?
  screens           Int     @default(1)
  accessNotes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id])
  plan     Plan?     @relation(fields: [planId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  charges  Charge[]

  @@index([status, nextDueAt])
  @@index([customerId])
  @@index([supplierId])
  // listPlans conta assinaturas ativas por plano: `planId IN (...) AND status = 'ACTIVE'`.
  // Composto e nao simples — o status na segunda posicao tira as canceladas do heap fetch,
  // nao do filtro. Medido: 2,58 ms (seq scan) -> 2,43 ms (so planId) -> 1,20 ms (composto).
  @@index([planId, status])
  @@map("subscriptions")
}

model CredentialReveal {
  id             String   @id @default(uuid(7))
  subscriptionId String
  userId         String
  revealedAt     DateTime @default(now())
  ip             String?

  @@index([subscriptionId, revealedAt])
  @@map("credential_reveals")
}

model Charge {
  id             String  @id @default(uuid(7))
  subscriptionId String
  customerId     String
  supplierId     String?

  principalCents BigInt
  discountCents  BigInt @default(0)
  costCents      BigInt @default(0)

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  dueAt       DateTime
  issuedAt    DateTime @default(now())

  status       ChargeStatus @default(OPEN)
  paidAt       DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])
  payments     Payment[]
  messages     Message[]
  executions   DunningExecution[]

  @@unique([subscriptionId, periodStart])
  @@index([status, dueAt])
  @@index([customerId, dueAt])
  @@map("charges")
}

model Payment {
  id             String        @id @default(uuid(7))
  chargeId       String
  amountCents    BigInt
  method         PaymentMethod @default(PIX)
  source         PaymentSource @default(MANUAL)
  externalId     String?
  idempotencyKey String?       @unique
  paidAt         DateTime
  note           String?
  createdAt      DateTime      @default(now())

  charge Charge @relation(fields: [chargeId], references: [id])

  @@unique([source, externalId])
  @@index([chargeId])
  @@index([paidAt])
  @@map("payments")
}

enum ChannelProvider {
  META_CLOUD
  EVOLUTION
  SALVY
}

model ChannelConfig {
  id             String          @id @default(uuid(7))
  provider       ChannelProvider @unique
  label          String
  isActive       Boolean         @default(false)
  isDefault      Boolean         @default(false)
  phoneNumber    String?
  credentials    String
  riskAcceptedAt DateTime?
  lastCheckAt    DateTime?
  lastCheckOk    Boolean?
  lastError      String?
  // Quando o webhook `connection.update` reportou `state: 'close'` pela última vez, null
  // enquanto conectado. Não é derivável de `lastCheckAt` (que é "quando testamos", não
  // "desde quando caiu") — é o que a faixa do dashboard mostra ao operador.
  disconnectedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  messages       Message[]

  @@map("channel_configs")
}

enum DunningStatus {
  DRAFT
  REVIEW
  ACTIVE
  PAUSED
}

enum DunningAction {
  SEND_MESSAGE
  SUSPEND
  NOTIFY_OWNER
}

model DunningRule {
  id        String        @id @default(uuid(7))
  name      String
  status    DunningStatus @default(DRAFT)
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  /// Carimbo da última passada de `evaluateDunningRule` para esta régua — `null`
  /// enquanto ela nunca rodou (DRAFT, ou REVIEW/ACTIVE que o cron ainda não
  /// alcançou). Só é escrito quando a régua está REVIEW ou ACTIVE (as únicas que
  /// o motor avalia); DRAFT e PAUSED não tocam esta coluna, então continuam
  /// mostrando o carimbo de antes de pausar.
  lastRunAt DateTime?

  /// Quantas Message novas esta passada de fato criou (mensagens que vão pro
  /// WhatsApp) — sempre 0 numa passada em REVIEW, que nunca cria Message.
  lastRunMessagesSent Int?

  /// Quantos passos viraram PENDING_REVIEW nesta passada — só cresce quando a
  /// régua está em REVIEW; ACTIVE nunca produz este outcome.
  lastRunPendingReview Int?

  steps     DunningStep[]

  @@map("dunning_rules")
}

model DunningStep {
  id               String        @id @default(uuid(7))
  ruleId           String
  offsetDays       Int
  action           DunningAction @default(SEND_MESSAGE)
  templateBody     String?
  /// Nome do template aprovado na Meta pra este passo — `null` até o operador
  /// modelar o template. Canal com `requiresApprovedTemplate` e passo sem isto
  /// vira execução `SKIPPED` (motivo `template_not_approved`) em vez de tentar
  /// texto livre que a Meta recusa fora da janela de 24h. Ver 06-regua-e-canais.md.
  metaTemplateName String?
  /// Mapeamento posicional das variáveis do template aprovado na Meta: array JSON de
  /// nomes de `TemplateVariable`, na ordem de {{1}}, {{2}}... Derivado automaticamente
  /// das variáveis usadas em `templateBody` ao salvar o passo (`stepFields` em
  /// `features/dunning/service.ts`) — não é um campo editável à parte, pra não deixar
  /// o texto aprovado na Meta e a ordem dos parâmetros divergirem. `null` sem
  /// `metaTemplateName`, `[]` quando o template não tem variável nenhuma.
  metaTemplateParams Json?
  isActive         Boolean       @default(true)

  rule         DunningRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  executions   DunningExecution[]

  @@unique([ruleId, offsetDays])
  @@map("dunning_steps")
}

enum MessageKind {
  DUNNING
  MANUAL
  TEST
  INBOUND
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
  SKIPPED
  RECEIVED
}

model Message {
  id            String         @id @default(uuid(7))
  customerId    String
  chargeId      String?
  channelId     String?
  kind          MessageKind    @default(DUNNING)
  status        MessageStatus  @default(PENDING)

  toPhone       String
  body          String
  /// Nome do template aprovado na Meta usado neste envio, congelado na avaliação —
  /// `null` em canal de texto livre, ou quando a régua consolidou mais de uma
  /// cobrança pro mesmo cliente sem template de consolidação aprovado (ver
  /// docs/projeto/tecnico/06-regua-e-canais.md).
  templateName  String?
  /// Valores posicionais pro template acima (`{"1": "João", "2": "R$ 60,00"}`),
  /// congelados junto com `body` — nunca recalculados no despacho.
  templateParams Json?
  scheduledFor  DateTime
  scheduledDate DateTime       @db.Date
  sentAt        DateTime?
  externalId    String?
  attempts      Int            @default(0)
  failReason    String?
  cancelReason  String?
  createdAt     DateTime       @default(now())

  customer      Customer       @relation(fields: [customerId], references: [id])
  charge        Charge?        @relation(fields: [chargeId], references: [id])
  channel       ChannelConfig? @relation(fields: [channelId], references: [id])
  executions    DunningExecution[]

  @@index([status, scheduledFor])
  @@index([customerId, createdAt])
  // A tela de Mensagens filtra por `occurredAt = sentAt ?? createdAt`, que vira
  // `sentAt BETWEEN ... OR (sentAt IS NULL AND createdAt BETWEEN ...)`. O composto faz os
  // dois ramos usarem o mesmo indice. Medido em 33.747 linhas: 5,82 ms -> 0,82 ms.
  @@index([sentAt, createdAt])
  @@map("messages")
}

enum ExecutionOutcome {
  QUEUED
  SKIPPED
  PENDING_REVIEW
}

model DunningExecution {
  id        String           @id @default(uuid(7))
  chargeId  String
  stepId    String
  outcome   ExecutionOutcome
  reason    String?
  messageId String?
  createdAt DateTime         @default(now())

  charge    Charge           @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  step      DunningStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  message   Message?         @relation(fields: [messageId], references: [id])

  @@unique([chargeId, stepId])
  @@index([messageId])
  // ⚠️ Existe tambem `dunning_executions_pending_idx` — parcial, `WHERE messageId IS NULL`,
  // para as execucoes que pararam antes de virar mensagem. Indice parcial nao e expressavel
  // aqui: vive como SQL manual em `migrations/00000000000013_index_plan_message_dunning`.
  @@map("dunning_executions")
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DISCARDED
}

/// Captação do site público — ver `docs/projeto/tecnico/02-modelo-de-dados.md`.
///
/// ⚠️ `phone` **não** é único aqui, de propósito: a mesma pessoa pode preencher
/// o formulário duas vezes, e recusar o segundo envio esconde um lead real. A
/// deduplicação acontece na tela, não no schema. A unicidade de WhatsApp só
/// vale em `customers`, e é resolvida na conversão.
model Lead {
  id           String     @id @default(uuid(7))
  name         String
  phone        String // E.164
  city         String?
  interestPlan String? // texto livre, vem do site
  source       String // bloco do site que gerou o lead (data-cta), ex.: "site · planos"
  campaign     String?
  landingPath  String?
  status       LeadStatus @default(NEW)
  customerId   String? // preenchido na conversão
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])

  // Filtro real da lista: chip de situação + ordenação por chegada.
  @@index([status, createdAt])
  @@index([phone])
  @@index([customerId])
  @@map("leads")
}

enum LeadAttemptOutcome {
  ACCEPTED
  INVALID
  RATE_LIMITED
}

/// Rate limit por IP do endpoint público de captação, contado em tabela — sem
/// Redis, mesmo desenho de `LoginAttempt`. Tabela própria de propósito: o
/// limite de captação é generoso (pessoa real manda uma vez) e o de login é
/// hostil; misturar os dois faria o spam de formulário travar o login do
/// operador, e vice-versa.
///
/// ⚠️ Não guarda telefone nem nome — é registro de tráfego, não de PII.
model LeadAttempt {
  id        String             @id @default(uuid(7))
  ip        String
  outcome   LeadAttemptOutcome
  createdAt DateTime           @default(now())

  @@index([ip, createdAt])
  // Poda da tabela: cresce com tráfego público e nunca é lida fora da janela.
  @@index([createdAt])
  @@map("lead_attempts")
}
