# Postgres (docker-compose db service) — este é o banco de dev, o que pnpm dev usa.
# Nunca aponte pnpm test:integration pra ele: as suítes afirmam totais globais
# (getMonthlySummary, getSupplierBreakdown) e qualquer dado de demonstração
# semeado aqui as derruba de forma não determinística. Ver prisma/README.md.
DATABASE_URL="postgresql://mtconexoes:mtconexoes@localhost:5442/mtconexoes"

# Postgres de integração (docker-compose db-test service) — banco isolado, só
# pnpm test:integration usa. Preparar com `pnpm db:migrate:test`. NUNCA rodar
# prisma/seed-demo.ts contra ele.
TEST_DATABASE_URL="postgresql://mtconexoes:mtconexoes@localhost:5443/mtconexoes"

# Session JWT signing (openssl rand -base64 32)
SESSION_SECRET="dev-session-secret-change-me-32-bytes-min"

# AES-256-GCM key, 32 bytes base64 (openssl rand -base64 32) — protects the subscriber's access password and WhatsApp channel credentials — CHANGE ME, this is a dev-only placeholder
CREDENTIAL_KEY="Q0hBTkdFLU1FLWRldi1jcmVkZW50aWFsLWtleS0zMmI="

# Dev-only bearer token the cron-sim container sends; production uses Cloud Scheduler OIDC instead
CRON_SECRET="dev-cron-secret"

META_WEBHOOK_VERIFY_TOKEN="dev-meta-webhook-verify-token"   # handshake de verificação do webhook Meta Cloud

# URL pública do painel. É a partir dela que o pareamento por QR monta a URL de webhook
# que a Evolution vai chamar (POST /api/webhooks/evolution). Em dev, o servidor Evolution
# precisa alcançar este endereço — localhost só funciona se ele rodar na mesma máquina.
APP_URL="http://localhost:3000"

NODE_ENV="development"

# Captação do site público (POST /api/leads) — ver docs/projeto/tecnico/08-site.md.
# Origens liberadas no CORS, separadas por vírgula. Vazia = libera qualquer
# origem (`*`), TEMPORÁRIO até o site ter domínio de produção — sem isso o
# navegador bloqueia o formulário e ele cai para o WhatsApp por falta de
# config. Apertar é preencher com a origem de produção do site quando ela
# existir; a allowlist volta a valer sozinha.
LEADS_ALLOWED_ORIGINS=""
# Cloudflare Turnstile. Vazio = validação desligada (o rate limit por IP continua
# valendo). Preencher assim que o site passar a enviar o token.
TURNSTILE_SECRET_KEY=""
